[Unit]
Description=Gunicorn service for the weather station current-readings page
After=network.target
# Never give up restarting - the page is unattended.
StartLimitIntervalSec=0

[Service]
User=klm
Group=klm

WorkingDirectory=/home/klm/weather/weather_web
Environment="PATH=/home/klm/weather/weather_web/.venv-web/bin"
# Must match STATUS_FILE in weather_daq/settings.py.
Environment="WEATHER_STATUS_FILE=/tmp/weather_current.json"
# Loopback only: the page is reached through nginx (which the Cloudflare
# Tunnel and the LAN talk to), never directly on port 8000.
ExecStart=/home/klm/weather/weather_web/.venv-web/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 \
    --timeout 30 --graceful-timeout 20 --max-requests 2000 --max-requests-jitter 200 \
    --limit-request-line 2048 --limit-request-fields 50 --limit-request-field_size 4094 app:app
Restart=always
RestartSec=10

# Sandbox. This process is internet-facing, so it gets only what it needs:
# read the repo, read /tmp/weather_current.json, talk TCP to the database.
# (PrivateTmp is deliberately NOT set - the DAQ's status file lives in /tmp.)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
